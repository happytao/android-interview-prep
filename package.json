{
  "name": "tech-interview-prep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/post-build.mjs",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.0",
    "lucide-vue-next": "^0.475.0",
    "mermaid": "^11.4.1",
    "minisearch": "^7.1.1",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "gray-matter": "^4.0.3",
    "happy-dom": "^16.8.1",
    "markdown-it": "^14.1.0",
    "shiki": "^3.2.1",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.4"
  }
}
